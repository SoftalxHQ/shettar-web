# Kamal production secrets are loaded from gitignored `.env.production`
# (see .kamal/secrets). Copy keys from .env.staging / .env.local as needed.
#
# Required KEY=value lines (no quotes):
#
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_IOS_APP_URL=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# NEXT_PUBLIC_FCM_VAPID_KEY=
# NEXT_PUBLIC_TIDIO_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_BROWSE_GATE_ENABLED=
#
# Docker Hub token: config/registry.yml (also gitignored)
