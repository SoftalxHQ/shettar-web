# Secrets for shettar-web Kamal production deploys.
# Pulled from local files that should NOT be checked into git.
#
# - config/registry.yml          → Docker Hub token (one line; copy from shettar-api if missing)
# - .env.production              → NEXT_PUBLIC_* (gitignored via .env*)

# Prefer local token; fall back to shettar-api (same Docker Hub account) or env.
KAMAL_REGISTRY_PASSWORD=$(
  cat config/registry.yml 2>/dev/null \
  || cat ../shettar-api/config/registry.yml 2>/dev/null \
  || echo "${KAMAL_REGISTRY_PASSWORD:-MISSING_REGISTRY_PASSWORD}"
)

# Read KEY=value from .env.production (blank if missing).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=$(sed -n 's/^NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=//p' .env.production 2>/dev/null | head -1)
