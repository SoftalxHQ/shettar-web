# Secrets for shettar-web Kamal production deploys.
# Loaded on your laptop before the build (not from the remote git clone).
#
# - config/registry.yml → Docker Hub token
# - .env.production     → NEXT_PUBLIC_* passed as Docker --build-arg (see deploy.yml)
#
# IMPORTANT: This file is dotenv, not a shell script. No if/fi/else — dotenv
# will treat `KAMAL_REGISTRY_PASSWORD="…"` lines as real assignments and
# overwrite the real token (that was the unauthorized login failure).

# Docker Hub PAT — strip trailing newline (newline breaks docker login -p).
# Do NOT use tr -d '\r\n' here: dotenv turns \r/\n into literal r/n before the
# shell runs, so tr deletes those letters from the token and login fails.
KAMAL_REGISTRY_PASSWORD=$(ruby -e 'print File.read("config/registry.yml").strip')

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=$(sed -n 's/^NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=$(sed -n 's/^NEXT_PUBLIC_GOOGLE_CLIENT_ID=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_IOS_APP_URL=$(sed -n 's/^NEXT_PUBLIC_IOS_APP_URL=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FIREBASE_API_KEY=$(sed -n 's/^NEXT_PUBLIC_FIREBASE_API_KEY=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=$(sed -n 's/^NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=$(sed -n 's/^NEXT_PUBLIC_FIREBASE_PROJECT_ID=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=$(sed -n 's/^NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=$(sed -n 's/^NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FIREBASE_APP_ID=$(sed -n 's/^NEXT_PUBLIC_FIREBASE_APP_ID=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=$(sed -n 's/^NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_FCM_VAPID_KEY=$(sed -n 's/^NEXT_PUBLIC_FCM_VAPID_KEY=//p' .env.production 2>/dev/null | head -1)
NEXT_PUBLIC_TIDIO_KEY=$(sed -n 's/^NEXT_PUBLIC_TIDIO_KEY=//p' .env.production 2>/dev/null | head -1)
# Public site key — keep as a literal. sed-from-.env.production is empty when Kamal
# expands secrets from the git clone (that file is gitignored).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADs3GPQCIgovfACF
NEXT_PUBLIC_BROWSE_GATE_ENABLED=$(sed -n 's/^NEXT_PUBLIC_BROWSE_GATE_ENABLED=//p' .env.production 2>/dev/null | head -1)
